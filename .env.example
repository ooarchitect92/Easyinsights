NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PORT=3000
MONGODB_URI=mongodb://localhost:27017/easyinsights?replicaSet=rs0
MONGODB_DB=easyinsights
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=easyinsights
KAFKA_GROUP_ID=easyinsights-consumer
SESSION_COOKIE_NAME=ei_session
SESSION_TTL_SECONDS=28800
RAW_EVENT_TTL_DAYS=90
IDEMPOTENCY_TTL_HOURS=24
OUTBOX_TTL_DAYS=14
RUN_TTL_DAYS=90
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
LIVE_ACTIVATION_ENABLED=false
ALLOWED_ACTIVATION_HOSTS=
AI_PROVIDER=deterministic
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
SEED_ADMIN_EMAIL=admin@easyinsights.local
SEED_ADMIN_PASSWORD=ChangeMe-Strong-2026!
